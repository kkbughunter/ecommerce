# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
SERVER_PORT=8080
FRONTEND_URL=https://your-store.example.com

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
DB_URL=jdbc:postgresql://localhost:5432/ecommerce
DB_USERNAME=ecommerce_user
DB_PASSWORD=change-me

# Keep update only when Hibernate is responsible for schema updates.
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
SPRING_JPA_OPEN_IN_VIEW=false

# Runs the idempotent role and email-template seed statements on startup.
SQL_INIT_MODE=always

# -----------------------------------------------------------------------------
# JWT and authentication
# -----------------------------------------------------------------------------
# Use a cryptographically random secret of at least 32 bytes.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_EXPIRATION=3600
JWT_REFRESH_EXPIRATION=86400
AUTH_OTP_EXPIRATION_MINUTES=10

# Replace every bootstrap value before deploying to production.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@villpo.com
BOOTSTRAP_ADMIN_PASSWORD=cyber7020@V#Admin
BOOTSTRAP_ADMIN_FULL_NAME=Villpo Admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=superadmin@villpo.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=cyber7020@V#SuperADMIN

# -----------------------------------------------------------------------------
# Email/SMTP
# -----------------------------------------------------------------------------
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=mailer@example.com
MAIL_PASSWORD=change-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# -----------------------------------------------------------------------------
# Cloudflare R2 product-image storage
# -----------------------------------------------------------------------------
# Use an R2 Account API token restricted to the bucket with Object Read & Write.
R2_ENABLED=true
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET=villpo-product-images
R2_PUBLIC_URL=https://images.sub.domain..com

# -----------------------------------------------------------------------------
# Image validation and background WebP processing
# -----------------------------------------------------------------------------
# Keep the byte limit consistent with IMAGE_MAX_FILE_SIZE.
IMAGE_MAX_FILE_SIZE=50MB
IMAGE_MAX_REQUEST_SIZE=200MB
IMAGE_MAX_FILE_BYTES=52428800
IMAGE_MAX_PIXELS=50000000
IMAGE_MAX_FILES_PER_REQUEST=8
IMAGE_WORKER_DELAY_MS=5000
IMAGE_WORKER_BATCH_SIZE=5
IMAGE_MAX_PROCESSING_ATTEMPTS=3

# -----------------------------------------------------------------------------
# Razorpay
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
RAZORPAY_API_BASE_URL=https://api.razorpay.com
RAZORPAY_CREATE_ORDER_TIMEOUT_MS=10000

# -----------------------------------------------------------------------------
# API documentation
# -----------------------------------------------------------------------------
# Disable these in production unless Swagger access is intentionally required.
SPRINGDOC_API_DOCS_ENABLED=false
SPRINGDOC_SWAGGER_UI_ENABLED=false
